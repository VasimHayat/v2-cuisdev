# Copy to .env and fill in.
# Google Analytics 4 measurement ID. Defaults to the production property in src/lib/site.ts;
# set a different one here for a staging build. Analytics never loads in `astro dev`.
PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console HTML-tag verification token (the content value only). Optional.
PUBLIC_GSC_VERIFICATION=

# Bing Webmaster verification token. Optional.
PUBLIC_BING_VERIFICATION=
