---
import ToolCard from './ToolCard.astro';
import type { Tool } from '@/data/tools';

interface Props {
  tools: Tool[];
  title?: string;
  /** `sidebar` stacks cards in one column for narrow asides; `grid` is for full-width sections. */
  variant?: 'grid' | 'sidebar';
}
const { tools, title = 'Related tools', variant = 'grid' } = Astro.props;
const sidebar = variant === 'sidebar';
---

{
  tools.length > 0 && (
    <section aria-labelledby="related-heading">
      <h2 id="related-heading" class={sidebar ? 'text-sm font-semibold' : 'text-2xl font-bold'}>
        {title}
      </h2>
      <div class={sidebar ? 'mt-3 grid gap-2' : 'mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3'}>
        {tools.map((t) => (
          <ToolCard tool={t} compact />
        ))}
      </div>
    </section>
  )
}
