  <rect width="32" height="32" rx="8" class="fill-brand-600" />
  <path d="M20.5 10.5a6.5 6.5 0 1 0 0 11" stroke="white" stroke-width="3" stroke-linecap="round" />
  <circle cx="22" cy="16" r="2" fill="white" />
</svg>
