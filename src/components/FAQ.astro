---
import type { FaqItem } from '@/lib/seo';

interface Props {
  items: FaqItem[];
  title?: string;
}
const { items, title = 'Frequently asked questions' } = Astro.props;
---

{
  items.length > 0 && (
    <section aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="text-2xl font-bold">{title}</h2>
      <div class="mt-5 divide-y divide-line rounded-lg border border-line">
        {items.map((f, i) => (
          <details class="group" open={i === 0}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-[15px] font-medium text-ink hover:bg-surface-2 [&::-webkit-details-marker]:hidden">
              {f.q}
              <span class="shrink-0 text-ink-3 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <div class="px-5 pb-5 text-sm leading-6 text-ink-2">{f.a}</div>
          </details>
        ))}
      </div>
    </section>
  )
}
