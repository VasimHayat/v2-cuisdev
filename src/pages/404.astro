---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ToolCard from '@/components/ToolCard.astro';
import Icon from '@/components/Icon.astro';
import { featuredTools } from '@/data/tools';
const popular = featuredTools().slice(0, 3);
---

<BaseLayout title="Page not found" description="That page does not exist. Search our tools or jump to a popular one." noindex>
  <div class="container-x py-20 text-center">
    <p class="font-mono text-sm text-ink-3">404</p>
    <h1 class="mt-3 text-3xl font-bold sm:text-4xl">That page does not exist</h1>
    <p class="mx-auto mt-3 max-w-md text-ink-2">The link may be old or mistyped. Search for a tool or pick a popular one below.</p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-2">
      <button type="button" class="btn-primary h-11 px-5" data-open-palette><Icon name="search" size={16} /> Search tools</button>
      <a href="/tools/" class="btn-secondary h-11 px-5">Browse all tools</a>
    </div>
    <div class="mx-auto mt-12 grid max-w-3xl gap-3 text-left sm:grid-cols-3">
      {popular.map((t) => <ToolCard tool={t} compact />)}
    </div>
  </div>
</BaseLayout>
