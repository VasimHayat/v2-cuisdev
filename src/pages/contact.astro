---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Icon from '@/components/Icon.astro';
import { SITE } from '@/lib/site';
import { graph, organizationLd, websiteLd, breadcrumbLd, type Crumb } from '@/lib/seo';

const crumbs: Crumb[] = [
  { name: 'Home', href: '/' },
  { name: 'Contact', href: '/contact/' },
];
const jsonLd = graph(organizationLd(), websiteLd(), breadcrumbLd(crumbs), { '@type': 'ContactPage', name: 'Contact Cuisdev', url: `${SITE.url}/contact/` });
---

<BaseLayout
  title="Contact Us or Request a Tool"
  description="Request a new tool, report a bug or ask a question. The Cuisdev team reads every message and the most requested tools ship first."
  canonical="/contact/"
  jsonLd={jsonLd}
>
  <div class="container-x max-w-3xl pt-5">
    <Breadcrumbs crumbs={crumbs} />
    <h1 class="mt-4 text-3xl font-bold sm:text-4xl">Contact</h1>
    <p class="mt-3 text-ink-2">Request a tool, report a bug or ask anything. We reply within two working days.</p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      <a href={`mailto:${SITE.email}?subject=Tool%20request`} class="card-hover flex items-start gap-3.5 p-5">
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-brand-50 text-brand-600 dark:bg-brand-900/40 dark:text-brand-300"><Icon name="sparkles" size={20} /></span>
        <span>
          <span class="block font-semibold">Request a tool</span>
          <span class="mt-1 block text-sm text-ink-2">Tell us the job you need done. The most requested tools ship first.</span>
        </span>
      </a>
      <a href={`mailto:${SITE.email}?subject=Bug%20report`} class="card-hover flex items-start gap-3.5 p-5">
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-brand-50 text-brand-600 dark:bg-brand-900/40 dark:text-brand-300"><Icon name="life-buoy" size={20} /></span>
        <span>
          <span class="block font-semibold">Report a bug</span>
          <span class="mt-1 block text-sm text-ink-2">Include the tool name, your browser and what you expected to happen.</span>
        </span>
      </a>
    </div>

    <div class="card mt-6 p-5">
      <p class="text-sm text-ink-2">
        Email: <a href={`mailto:${SITE.email}`} class="font-medium text-brand-600 underline">{SITE.email}</a>
      </p>
      <p class="mt-2 text-sm text-ink-3">We do not need your data to help. Never email us files containing passwords, tokens or personal information. Describe the problem instead.</p>
    </div>
  </div>
</BaseLayout>
