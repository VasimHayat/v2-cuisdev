---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { TOOLS, WAVES, toolPath, getCategory, toolsInWave, type Wave } from '@/data/tools';
import { graph, organizationLd, websiteLd, breadcrumbLd, type Crumb } from '@/lib/seo';

const crumbs: Crumb[] = [
  { name: 'Home', href: '/' },
  { name: 'Changelog', href: '/changelog/' },
];
const live = TOOLS.filter((t) => t.status === 'live').sort((a, b) => b.since.localeCompare(a.since));
const waves = (Object.keys(WAVES).map(Number) as Wave[])
  .map((w) => ({ wave: w, ...WAVES[w], tools: toolsInWave(w).filter((t) => t.status === 'soon') }))
  .filter((w) => w.tools.length);
const fmt = (iso: string) => new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
const jsonLd = graph(organizationLd(), websiteLd(), breadcrumbLd(crumbs));
---

<BaseLayout
  title="Changelog - What Shipped and What Is Next"
  description="Every tool Cuisdev has shipped, with dates, and the tools planned next. Updated on every release."
  canonical="/changelog/"
  jsonLd={jsonLd}
>
  <div class="container-x max-w-3xl pt-5">
    <Breadcrumbs crumbs={crumbs} />
    <h1 class="mt-4 text-3xl font-bold sm:text-4xl">Changelog</h1>
    <p class="mt-2 text-ink-2">What shipped, and what is next. Dates for planned tools are targets, not promises.</p>

    <h2 class="mt-10 text-xl font-bold">Shipped</h2>
    <ul class="mt-4 divide-y divide-line rounded-lg border border-line">
      {live.map((t) => (
        <li class="flex items-center justify-between gap-4 px-4 py-3 text-sm">
          <a href={toolPath(t)} class="font-medium text-ink hover:text-brand-600">{t.name}</a>
          <span class="text-ink-3">{getCategory(t.category)?.name} · {fmt(t.since)}</span>
        </li>
      ))}
    </ul>

    <h2 class="mt-10 text-xl font-bold text-ink-2">Planned, by launch wave</h2>
    <p class="mt-1 text-sm text-ink-3">Waves follow the rebuild plan. Weeks are counted from the project kickoff on 2 October 2026.</p>
    {
      waves.map((w) => (
        <section class="mt-6" aria-labelledby={`wave-${w.wave}`}>
          <h3 id={`wave-${w.wave}`} class="text-sm font-semibold text-ink-2">
            Wave {w.wave}: {w.name} <span class="font-normal text-ink-3">· {w.weeks}</span>
          </h3>
          <ul class="mt-2 divide-y divide-line rounded-lg border border-line">
            {w.tools.map((t) => (
              <li class="flex items-center justify-between gap-4 px-4 py-2.5 text-sm">
                <span class="text-ink-2">{t.name}</span>
                <span class="text-ink-3">{getCategory(t.category)?.name} · target {fmt(t.since)}</span>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>
