---
import '@/styles/global.css';
import SEO from '@/components/SEO.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Analytics from '@/components/Analytics.astro';
import CommandPalette from '@/components/CommandPalette.astro';
import { SITE } from '@/lib/site';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: string;
  publishedTime?: string;
  modifiedTime?: string;
  /** Extra classes on <main>. */
  class?: string;
}
const { class: className = '', ...seo } = Astro.props;
---

<!doctype html>
<html lang={SITE.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1b1c21" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} blog`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <SEO {...seo} />

    <!-- Theme before paint: avoids a flash and keeps CLS at zero. -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('cuis-theme');
          var dark = t ? t === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
          if (dark) document.documentElement.classList.add('dark');
        } catch (e) {}
      })();
    </script>
    <Analytics />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-md focus:bg-brand-600 focus:px-3 focus:py-2 focus:text-white">
      Skip to content
    </a>
    <Header />
    <main id="main" class:list={['flex-1', className]}>
      <slot />
    </main>
    <Footer />
    <CommandPalette />
    <div id="toast-root" class="pointer-events-none fixed inset-x-0 bottom-6 z-[70] flex flex-col items-center gap-2" aria-live="polite"></div>
  </body>
</html>
